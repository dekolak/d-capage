// Schéma de données — voir docs/ARCHITECTURE.md.
// Principe : les valeurs de réglage sont en JSON, validées par @decapage/machine-kit
// selon la version d'interface de la machine. Ajouter une machine ne modifie pas ce schéma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Visibilite {
  PRIVEE
  PARTAGEE
}

enum TypePhoto {
  AVANT
  APRES
  INTERFACE
  AUTRE
}

// ---------- Utilisateurs ----------

/// Prévu pour plus tard : une entreprise avec plusieurs utilisateurs.
model Organisation {
  id        String   @id @default(cuid())
  nom       String
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id                      String        @id @default(cuid())
  identifiant             String        @unique
  passwordHash            String
  nom                     String?
  role                    Role          @default(USER)
  /// Client Lazzeko (oui) ou utilisateur d'une autre marque (non) : sert au ciblage des messages.
  clientLazzeko           Boolean       @default(true)
  /// N° de client dans Odoo (plusieurs comptes peuvent partager le même n°, ex. une entreprise).
  numeroOdoo              String?
  /// Accord facultatif pour que Lazzeko réutilise les photos (site, réseaux, documentation).
  accordPhotosMarketing   Boolean       @default(false)
  accordPhotosMarketingLe DateTime?
  /// Langue de l'app pour ce compte (fr, en…) ; null = langue du téléphone.
  langue                  String?
  actif                   Boolean       @default(true)
  organisationId          String?
  organisation            Organisation? @relation(fields: [organisationId], references: [id])
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  machines         UserMachine[]
  fiches           Fiche[]
  evaluations      Evaluation[]
  apiKeys          ApiKey[]
  lecturesAnnonces AnnonceLecture[]
  reponsesAnnonces AnnonceReponse[]
  demandesAide     DemandeAide[]
  /// Modules accessibles (et donc espaces : Lazzeko, Kiavik…) — voir src/espaces/espaces.ts.
  modules          UserModule[]
  /// Conditions d'utilisation acceptées, par espace.
  acceptations     AcceptationConditions[]

  @@index([numeroOdoo])
  activites               Activite[]
}

/// Accès d'un compte à un module (slug défini dans src/espaces/espaces.ts, ex. reglages-decapage).
model UserModule {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  createdAt DateTime @default(now())

  @@id([userId, module])
  @@index([module])
}

/// Version des conditions d'utilisation acceptée par un compte, pour un espace.
model AcceptationConditions {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  espace     String
  version    Int
  accepteeLe DateTime @default(now())

  @@id([userId, espace])
}

/// Clé API pour créer des comptes depuis un autre système (site, CRM…).
/// Seul le hash est stocké ; la clé en clair n'est montrée qu'une fois.
model ApiKey {
  id                  String    @id @default(cuid())
  nom                 String
  prefixe             String    @unique
  hash                String
  creeParId           String?
  creePar             User?     @relation(fields: [creeParId], references: [id])
  derniereUtilisation DateTime?
  revoqueeLe          DateTime?
  createdAt           DateTime  @default(now())
}

// ---------- Catalogue machines ----------

model Technologie {
  id      String   @id @default(cuid())
  slug    String   @unique // = clé du module de calcul (ex. laser-pulse)
  nom     String
  modeles Modele[]
}

model Fabricant {
  id      String   @id @default(cuid())
  slug    String   @unique
  nom     String
  modeles Modele[]
}

model Modele {
  id            String      @id @default(cuid())
  slug          String
  nom           String
  fabricantId   String
  fabricant     Fabricant   @relation(fields: [fabricantId], references: [id])
  technologieId String
  technologie   Technologie @relation(fields: [technologieId], references: [id])
  /// Miniature de la machine (clé de stockage) : envoyée par l'admin, PNG de préférence.
  imageCle      String?
  imageMaj      DateTime?
  variantes     Variante[]

  @@unique([fabricantId, slug])
}

/// Ex. 300 W. Une variante a une ou plusieurs versions d'interface.
model Variante {
  id       String             @id @default(cuid())
  slug     String
  nom      String
  modeleId String
  modele   Modele             @relation(fields: [modeleId], references: [id])
  actif    Boolean            @default(true)
  /// Miniature propre à la variante (sinon celle du modèle).
  imageCle String?
  imageMaj DateTime?
  versions VersionInterface[]
  machines UserMachine[]

  @@unique([modeleId, slug])
}

/// Config miroir (JSON validé par machine-kit). Une fiche pointe vers une version précise :
/// si le menu de la machine change, on crée une nouvelle version et les anciennes fiches restent lisibles.
model VersionInterface {
  id         String   @id @default(cuid())
  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id])
  numero     Int
  config     Json
  publiee    Boolean  @default(true)
  createdAt  DateTime @default(now())
  fiches     Fiche[]

  @@unique([varianteId, numero])
}

/// Machines possédées par un utilisateur (pas de numéro de série).
model UserMachine {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id])
  surnom     String?
  createdAt  DateTime @default(now())
  fiches     Fiche[]

  @@unique([userId, varianteId, surnom])
}

// ---------- Tags ----------

/// Ex. « Matériau », « À enlever », « Application ». Administrable.
model GroupeTag {
  id    String @id @default(cuid())
  slug  String @unique
  nom   String
  ordre Int    @default(0)
  tags  Tag[]
}

model Tag {
  id       String     @id @default(cuid())
  slug     String
  nom      String
  groupeId String
  groupe   GroupeTag  @relation(fields: [groupeId], references: [id])
  valide   Boolean    @default(true) // false = proposé par un utilisateur, à valider
  fiches   FicheTag[]

  @@unique([groupeId, slug])
}

// ---------- Fiches réglage ----------

model Fiche {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMachineId      String?
  userMachine        UserMachine?     @relation(fields: [userMachineId], references: [id], onDelete: SetNull)
  versionInterfaceId String
  versionInterface   VersionInterface @relation(fields: [versionInterfaceId], references: [id])
  titre              String
  commentaire        String?
  /// Valeurs saisies dans le miroir (uniquement les champs `enregistre`).
  valeurs            Json
  /// Toutes les fiches sont partagées (mise en commun). PRIVEE reste possible via l'API pour plus tard.
  visibilite         Visibilite       @default(PARTAGEE)
  /// Dénormalisé (mis à jour à chaque note) pour trier la communauté en base.
  /// Masquée par un admin (modération) : invisible pour tous sauf l'auteur et les admins.
  masquee            Boolean          @default(false)
  masqueeLe          DateTime?
  /// Raison et origine de la modération (« admin », « auto » pour une IA via l'API…).
  moderationRaison   String?
  moderePar          String?
  noteMoyenne        Float?
  nbNotes            Int              @default(0)
  /// Fiche d'origine quand on duplique le réglage d'un autre.
  parentId           String?
  parent             Fiche?           @relation("Duplication", fields: [parentId], references: [id], onDelete: SetNull)
  copies             Fiche[]          @relation("Duplication")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tags         FicheTag[]
  photos       Photo[]
  evaluations  Evaluation[]
  demandesAide DemandeAide[]

  @@index([versionInterfaceId, visibilite])
  @@index([visibilite, noteMoyenne])
}

model FicheTag {
  ficheId String
  fiche   Fiche  @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id])

  @@id([ficheId, tagId])
  @@index([tagId])
}

model Photo {
  id        String    @id @default(cuid())
  ficheId   String
  fiche     Fiche     @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  type      TypePhoto
  cle       String // chemin dans le stockage
  miniature String?
  largeur   Int?
  hauteur   Int?
  ordre     Int       @default(0)
  createdAt DateTime  @default(now())
}

enum StatutAvis {
  VISIBLE
  EN_ATTENTE // modération préalable (MODERATION_PREALABLE_AVIS=true) : invisible jusqu'à validation
  MASQUE
}

/// Note 1 à 5 + avis : un par utilisateur et par fiche (l'auteur note aussi sa propre fiche).
/// Pas de réponses : on évite les discussions.
model Evaluation {
  id               String     @id @default(cuid())
  ficheId          String
  fiche            Fiche      @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  note             Int
  avis             String?
  statut           StatutAvis @default(VISIBLE)
  moderationRaison String?
  moderePar        String?
  modereLe         DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([ficheId, userId])
  @@index([statut, updatedAt])
}

// ---------- Webhooks (envoi des publications vers un service externe, ex. modération IA) ----------

/// Un abonné externe : reçoit en POST JSON signé chaque événement choisi.
model Webhook {
  id         String             @id @default(cuid())
  nom        String
  url        String
  /// Secret de signature HMAC (en clair : nécessaire pour signer).
  secret     String
  /// Événements : fiche.creee, fiche.modifiee, avis.publie, avis.modifie (vide = tous).
  evenements String[]
  actif      Boolean            @default(true)
  createdAt  DateTime           @default(now())
  livraisons WebhookLivraison[]
}

enum StatutLivraison {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

/// File d'envoi persistante : rien n'est perdu si le serveur redémarre ; nouvelles tentatives espacées.
model WebhookLivraison {
  id             String          @id @default(cuid())
  webhookId      String
  webhook        Webhook         @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  evenement      String
  charge         Json
  statut         StatutLivraison @default(EN_ATTENTE)
  tentatives     Int             @default(0)
  prochainEssai  DateTime        @default(now())
  dernierCode    Int?
  derniereErreur String?
  createdAt      DateTime        @default(now())
  envoyeLe       DateTime?

  @@index([statut, prochainEssai])
}

// ---------- Paramètres et demandes d'aide ----------

/// Réglages de l'app modifiables par l'admin (ex. aideSupport = afficher le bouton d'aide).
model Parametre {
  cle    String   @id
  valeur Json
  maj    DateTime @updatedAt
}

/// « Demander de l'aide à Lazzeko » depuis une fiche (bouton masqué tant que aideSupport est désactivé).
model DemandeAide {
  id        String   @id @default(cuid())
  ficheId   String
  fiche     Fiche    @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  /// Espace d'où vient la demande (lazzeko, kiavik…).
  espace    String   @default("lazzeko")
  traitee   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([traitee, createdAt])
}

// ---------- Messages (bulles d'information à l'ouverture de l'app) ----------

enum NiveauAnnonce {
  CONSEIL
  INFO
  IMPORTANT // affiché en grand, à fermer pour continuer
}

/// Question facultative posée dans un message (une seule par message).
enum TypeQuestion {
  AUCUNE
  OUI_NON
  CHOIX
  NOTE
  TEXTE
}

enum Recurrence {
  AUCUNE
  JOURS
  SEMAINES
  MOIS
}

enum CibleClient {
  TOUS
  LAZZEKO
  AUTRES
}

/// Message de l'admin vers les utilisateurs (pas de réponse possible).
model Annonce {
  id                 String           @id @default(cuid())
  titre              String
  texte              String
  niveau             NiveauAnnonce    @default(INFO)
  lienUrl            String?
  lienTexte          String?
  debut              DateTime         @default(now())
  fin                DateTime?
  actif              Boolean          @default(true)
  /// Message périodique : réapparaît tous les `intervalle` jours / semaines / mois après « J'ai compris ».
  recurrence         Recurrence       @default(AUCUNE)
  intervalle         Int              @default(1)
  /// Espaces visés (vide = tous) : le message s'affiche dans ces espaces, aux comptes qui y ont accès.
  espaces            String[]
  /// Ciblage (listes vides = toutes les machines).
  cibleClient        CibleClient      @default(TOUS)
  fabricantIds       String[]
  modeleIds          String[]
  varianteIds        String[]
  /// Ciblage par n° de client Odoo (vide = pas de restriction).
  numerosOdoo        String[]
  /// Question (facultative) : réponse en un toucher dans la bulle, une par personne et par période.
  questionType       TypeQuestion     @default(AUCUNE)
  question           String?
  options            String[]
  autreOption        Boolean          @default(false)
  reponseObligatoire Boolean          @default(false)
  reponses           AnnonceReponse[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  lectures           AnnonceLecture[]
}

/// Vu / compris par utilisateur et par occurrence (0 pour un message ponctuel, n° de période sinon).
model AnnonceLecture {
  annonceId  String
  annonce    Annonce   @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence Int
  vueLe      DateTime  @default(now())
  compriseLe DateTime?

  @@id([annonceId, userId, occurrence])
}

/// Réponse à la question d'un message : valeur = « oui » / « non », texte de l'option, « 1 » à « 5 », ou texte libre.
model AnnonceReponse {
  id         String   @id @default(cuid())
  annonceId  String
  annonce    Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence Int
  valeur     String
  /// Précision quand l'utilisateur choisit « Autre ».
  autre      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([annonceId, userId, occurrence])
}

/// Procédure Kiavik (pas à pas), créée et modifiée par l'admin depuis l'app.
model Procedure {
  id        String           @id @default(cuid())
  /// Clé fixe des procédures livrées par le seed (kit-guides/procedures.json) ; null si créée dans l'app.
  cle       String?          @unique
  titre     String
  categorie String           @default("Impression")
  resume    String?
  /// Module requis pour la voir.
  module    String           @default("procedures-kiavik")
  publiee   Boolean          @default(false)
  ordre     Int              @default(0)
  etapes    EtapeProcedure[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

/// Étape d'une procédure : texte, avertissement, photo et lien vers une pastille d'un guide, tous facultatifs sauf le texte.
model EtapeProcedure {
  id            String    @id @default(cuid())
  procedureId   String
  procedure     Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  ordre         Int
  texte         String
  avertissement String?
  photoCle      String?
  photoMaj      DateTime?
  /// Lien vers une pastille : guide (slug), écran (id), pastille (id).
  guide         String?
  ecran         String?
  pastille      String?

  @@index([procedureId, ordre])
}

/// Correction d'un guide Kiavik faite par l'admin depuis l'app, appliquée par-dessus les fichiers d'origine (kit-guides).
/// type « pastille » (cle = écran/pastille : titre, texte, conseil, niveau, mots-clés), « etape » (cle = animation/scène/étape : sous-titre),
/// « photo » (cle = animation/photo : photo remplacée, fichier dans le stockage). Supprimer = revenir à l'original.
model CorrectionGuide {
  id        String   @id @default(cuid())
  guide     String
  type      String
  cle       String
  valeur    Json     @default("{}")
  photoCle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guide, type, cle])
}

/// Fiche « Astuces & solutions » (Kiavik) : un symptôme, pourquoi, que faire, liens vers un bouton et une procédure.
/// Créée et modifiée par l'admin depuis l'app ; sert aussi de base de connaissances (recherche, futur assistant).
model Solution {
  id            String    @id @default(cuid())
  /// Clé fixe des fiches livrées par le seed (kit-guides/solutions.json) ; null si créée dans l'app.
  cle           String?   @unique
  titre         String
  categorie     String    @default("Impression")
  cause         String?
  texte         String
  avertissement String?
  motsCles      String[]
  guide         String?
  ecran         String?
  pastille      String?
  procedureId   String?
  photoCle      String?
  photoMaj      DateTime?
  module        String    @default("procedures-kiavik")
  publiee       Boolean   @default(false)
  ordre         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Journal d'activité d'un client (connexions, pages consultées, recherches), visible par l'admin, effacé après 12 mois.
model Activite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  espace    String?
  /// connexion | page | recherche
  type      String
  chemin    String?
  /// Titre de la page ou texte recherché.
  detail    String?
  resultats Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
