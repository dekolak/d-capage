  "presets": [],
  "guide": [
    {
      "titre": {
        "fr": "Par où commencer ?"
      },
      "texte": {
        "fr": "Partez d'un réglage existant (le vôtre ou un réglage 4 étoiles de la communauté) et ne changez qu'un paramètre à la fois. Essai sur une petite zone, comparaison avant / après, puis notez le résultat."
      }
    },
    {
      "titre": {
        "fr": "Puissance, fréquence et plafond de 15 mJ"
      },
      "texte": {
        "fr": "Énergie par impulsion = puissance ÷ fréquence, plafonnée à 15 mJ. À 100 % (300 W), 20 kHz donne exactement 15 mJ. En dessous de 20 kHz, l'énergie ne monte plus : la puissance réelle baisse. Pour décaper fort, restez autour de 20 kHz ; pour la finition, montez la fréquence."
      }
    },
    {
      "titre": {
        "fr": "Vitesse et recouvrement"
      },
      "texte": {
        "fr": "Écart entre deux impulsions = vitesse (mm/s) ÷ (fréquence en kHz × 1000). Exemple : 1000 mm/s à 20 kHz = 0,05 mm, plus petit que le spot (≈ 0,1 mm) : les impulsions se recouvrent."
      }
    },
    {
      "titre": {
        "fr": "Remplissage"
      },
      "texte": {
        "fr": "Pour les ellipses et rectangles remplis, un intervalle proche du spot (0,05 à 0,1 mm) donne un nettoyage uniforme. Un intervalle plus grand laisse des bandes."
      }
    },
    {
      "titre": {
        "fr": "Sécurité"
      },
      "texte": {
        "fr": "Lunettes de protection laser obligatoires. Gaz raccordé (0,8 à 1,2 bar) pour protéger la lentille. Sur la machine : 2 appuis rapides puis maintenir le bouton pour tirer."
      }
    }
  ],
