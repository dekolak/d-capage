  "presets": [],
  "guide": [
    {
      "titre": {
        "fr": "Par où commencer ?"
      },
      "texte": {
        "fr": "Partez d'un réglage existant (le vôtre ou un réglage 4 étoiles de la communauté) pour le même matériau et la même épaisseur. Ne changez qu'un paramètre à la fois et faites un essai sur une chute."
      }
    },
    {
      "titre": {
        "fr": "Puissance de sortie"
      },
      "texte": {
        "fr": "Puissance de sortie = puissance du laser × PwrPeak × PwmWid. PwrPeak est le réglage principal ; laissez PwmWid à 100 % pour souder en continu."
      }
    },
    {
      "titre": {
        "fr": "Largeur de balayage et fil"
      },
      "texte": {
        "fr": "La largeur de balayage vaut en général 2 à 3,5 fois le diamètre du fil. Trop étroit : le fil fond mal, cordon bombé. Trop large : énergie étalée, moins de pénétration."
      }
    },
    {
      "titre": {
        "fr": "Sans fil d'apport"
      },
      "texte": {
        "fr": "Sur des tôles fines bien jointives, on peut souder sans fil : coupez « Fil d'apport ». Le cordon est plus fin."
      }
    },
    {
      "titre": {
        "fr": "Début et fin de soudure"
      },
      "texte": {
        "fr": "Les rampes (Avancé) évitent le trou au départ (montée) et le cratère à la fin (descente). Gardez le post-soufflage pour protéger la soudure qui refroidit."
      }
    },
    {
      "titre": {
        "fr": "Sécurité"
      },
      "texte": {
        "fr": "Lunettes de protection laser obligatoires, câble de masse relié à la pièce, pointe de la tête au contact avant de tirer. « Laser Fr » sur OFF bloque le tir."
      }
    }
  ],
  "source": {
    "date": "2026-11-19",
    "auteur": "Lazzeko (simulateur HTML de l'écran)",
    "notice": "Écran soudeuse laser 1500 / 2000 / 3000 W",
    "notes": [
      "Base commune aux soudeuses laser : chaque puissance a son fichier (machines/lazzeko/soudeuse-laser-<puissance>/v1.json).",
      "Non repris dans la fiche : Laser Fr (sécurité), Guide laser (pointeur), sens du fil, température de la lentille (affichages ou sécurité).",
      "Diamètre du fil ajouté (pas sur l'écran) : utile pour comparer les réglages.",
      "Menu nettoyage de la soudeuse : à ajouter (v2) quand son écran sera fourni.",
      "Apparence « écran » : couleurs, colonnes et libellés repris de l'écran de la machine."
    ]
  },
  "apparence": "ecran"
